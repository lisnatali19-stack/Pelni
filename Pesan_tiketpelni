```html
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pemesanan Tiket Kapal PELNI</title>
    <style>
        * {
            box-sizing: border-box;
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
        }
        body {
            background-color: #f4f6f9;
            padding: 20px;
        }
        .container {
            max-width: 600px;
            background: #ffffff;
            margin: 20px auto;
            padding: 25px;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }
        h2 {
            color: #004b87;
            text-align: center;
            margin-bottom: 20px;
        }
        .form-group {
            margin-bottom: 15px;
        }
        label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
            color: #333;
        }
        input, select {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 14px;
        }
        .form-row {
            display: flex;
            gap: 15px;
        }
        .form-row .form-group {
            flex: 1;
        }
        button {
            width: 100%;
            background-color: #004b87;
            color: white;
            border: none;
            padding: 12px;
            font-size: 16px;
            font-weight: bold;
            border-radius: 4px;
            cursor: pointer;
            margin-top: 10px;
        }
        button:hover {
            background-color: #003366;
        }
    </style>
</head>
<body>

<div class="container">
    <h2>Form Pemesanan Tiket PELNI</h2>
    <form action="#" method="POST">
        <div class="form-group">
            <label for="nama">Nama Lengkap (Sesuai KTP)</label>
            <input type="text" id="nama" name="nama" required placeholder="Masukkan nama lengkap">
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="nik">Nomor KTP/NIK</label>
                <input type="text" id="nik" name="nik" required placeholder="16 digit NIK">
            </div>
            <div class="form-group">
                <label for="hp">No. WhatsApp/Telepon</label>
                <input type="tel" id="hp" name="hp" required placeholder="08xxxxxxxxxx">
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="asal">Pelabuhan Asal</label>
                <select id="asal" name="asal" required>
                    <option value="">-- Pilih Pelabuhan Asal --</option>
                    <option value="Tanjung Priok (Jakarta)">Tanjung Priok (Jakarta)</option>
                    <option value="Tanjung Perak (Surabaya)">Tanjung Perak (Surabaya)</option>
                    <option value="Makassar">Makassar</option>
                    <option value="Belawan (Medan)">Belawan (Medan)</option>
                </select>
            </div>
            <div class="form-group">
                <label for="tujuan">Pelabuhan Tujuan</label>
                <select id="tujuan" name="tujuan" required>
                    <option value="">-- Pilih Pelabuhan Tujuan --</option>
                    <option value="Tanjung Perak (Surabaya)">Tanjung Perak (Surabaya)</option>
                    <option value="Makassar">Makassar</option>
                    <option value="Ambon">Ambon</option>
                    <option value="Sorong">Sorong</option>
                </select>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="kapal">Nama Kapal</label>
                <select id="kapal" name="kapal" required>
                    <option value="">-- Pilih Kapal --</option>
                    <option value="KM Kelud">KM Kelud</option>
                    <option value="KM Labobar">KM Labobar</option>
                    <option value="KM Dobonsolo">KM Dobonsolo</option>
                    <option value="KM Sinabung">KM Sinabung</option>
                </select>
            </div>
            <div class="form-group">
                <label for="kelas">Kelas Penumpang</label>
                <select id="kelas" name="kelas" required>
                    <option value="Ekonomi">Ekonomi</option>
                    <option value="Kelas 1A">Kelas 1A</option>
                    <option value="Kelas 1B">Kelas 1B</option>
                    <option value="Kelas 2A">Kelas 2A</option>
                </select>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="tanggal">Tanggal Keberangkatan</label>
                <input type="date" id="tanggal" name="tanggal" required>
            </div>
            <div class="form-group">
                <label for="jumlah">Jumlah Penumpang</label>
                <input type="number" id="jumlah" name="jumlah" min="1" max="10" value="1" required>
            </div>
        </div>

        <button type="submit">Cari & Pesan Tiket</button>
    </form>
</div>

</body>
</html>

